# Copy to .env and edit if you want, or set environment variables before start.
COMFY_URL=http://127.0.0.1:8188
# Must exactly match the checkpoint file name shown by ComfyUI.
COMFY_CHECKPOINT=your_model.safetensors
# Optional: LoRA under ComfyUI/models/loras/
COMFY_LORA=
COMFY_LORA_STRENGTH=0.8
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
